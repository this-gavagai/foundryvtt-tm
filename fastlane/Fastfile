default_platform(:ios)

private_lane :sync_capacitor do
  sh("npm run cap:sync")
end

private_lane :apple_team_id do
  team_id = ENV["IOS_DEVELOPMENT_TEAM"]
  UI.user_error!("Set IOS_DEVELOPMENT_TEAM to your Apple development team ID before running this lane.") if team_id.to_s.empty?

  team_id
end

private_lane :app_store_connect_key do
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_KEY_CONTENT"]
  key_filepath = ENV["APP_STORE_CONNECT_KEY_FILE"]

  UI.user_error!("Set APP_STORE_CONNECT_KEY_ID before running this lane.") if key_id.to_s.empty?
  UI.user_error!("Set APP_STORE_CONNECT_ISSUER_ID before running this lane.") if issuer_id.to_s.empty?

  # Prefer the inline (base64) key on CI, where there is no .p8 file on disk;
  # fall back to the local file path for developer machines.
  if !key_content.to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true
    )
  elsif !key_filepath.to_s.empty?
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )
  else
    UI.user_error!("Set APP_STORE_CONNECT_KEY_FILE (local .p8 path) or APP_STORE_CONNECT_KEY_CONTENT (base64 .p8 for CI) before running this lane.")
  end
end

platform :ios do
  desc "Create (or download) the Apple Distribution certificate and export a .p12"
  desc "for the IOS_DIST_CERT_BASE64 GitHub secret. Run once, then export/encode the"
  desc "result. Pass an output dir + password, e.g.:"
  desc "  bundle exec fastlane ios certificates dist_cert_password:hunter2"
  lane :certificates do |options|
    api_key = app_store_connect_key
    # Absolute so the openssl steps below don't depend on fastlane's working dir.
    output_path = File.expand_path(options[:output_path] || "fastlane/certs")
    password = options[:dist_cert_password]
    UI.user_error!("Pass dist_cert_password:<password> to protect the exported .p12.") if password.to_s.empty?

    get_certificates(
      api_key: api_key,
      development: false,
      output_path: output_path,
      generate_apple_certs: true
    )

    cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
    cer = File.join(output_path, "#{cert_id}.cer")        # certificate (DER)
    key_pem = File.join(output_path, "#{cert_id}.p12")    # private key (PEM, despite the extension)
    cert_pem = File.join(output_path, "#{cert_id}.pem")
    p12 = File.join(output_path, "dist.p12")

    # Bundle the cert + private key into one password-protected PKCS#12 for the
    # IOS_DIST_CERT_BASE64 secret. Pass the password via env so it never lands in
    # the process list. -legacy keeps it importable by macOS `security`.
    ENV["TM_P12_PASS"] = password
    sh("openssl", "x509", "-inform", "der", "-in", cer, "-out", cert_pem)
    sh("openssl", "pkcs12", "-export", "-legacy", "-inkey", key_pem, "-in", cert_pem, "-out", p12, "-passout", "env:TM_P12_PASS")

    UI.success("Distribution .p12 written to #{p12}")
    UI.important("Add these GitHub secrets, then delete #{output_path}:")
    UI.message("  IOS_DIST_CERT_BASE64    = output of:  base64 -i #{p12}")
    UI.message("  IOS_DIST_CERT_PASSWORD  = #{password}")
  end

  desc "Build a signed iOS release IPA from the Capacitor app"
  lane :build do
    sync_capacitor

    team_id = apple_team_id

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "development",
      clean: true,
      export_team_id: team_id,
      output_directory: "build",
      xcargs: "DEVELOPMENT_TEAM=#{team_id}"
    )
  end

  desc "Build an unsigned IPA for sideloading (Sideloadly, AltStore)"
  desc "Deliberately unsigned: whoever installs it re-signs with their own Apple ID,"
  desc "so our signature would only be stripped again. That also means this lane needs"
  desc "no certificate, profile, or App Store Connect key — unlike every other iOS lane."
  lane :unsigned do
    sync_capacitor

    # fastlane runs with the working directory set to fastlane/, not the repo
    # root, so the shell-level paths below are ../-relative. (The fastlane
    # actions used elsewhere in this file resolve from the root instead.)
    derived = "../build/unsigned-dd"
    payload = "../build/Payload"
    ipa     = "../build/tabulamensa-unsigned.ipa"

    sh("rm", "-rf", derived, payload, ipa)

    args = [
      "xcodebuild",
      "-project", "../ios/App/App.xcodeproj",
      "-scheme", "App",
      "-configuration", "Release",
      "-sdk", "iphoneos",
      "-derivedDataPath", derived,
      "CODE_SIGNING_ALLOWED=NO",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGN_IDENTITY=",
      # Drops aps-environment from the binary. A free Apple ID can't be granted
      # the push entitlement, so leaving it in makes the re-signing tools fail
      # outright instead of merely losing notifications.
      "CODE_SIGN_ENTITLEMENTS="
    ]

    # The tag's digits become the build number, so a sideloaded IPA reports the
    # release it came from. to_i drops the tag's zero padding (alpha-0165 -> 165)
    # to match what the beta lane sends to TestFlight; interpolating the raw
    # string would write a non-canonical "0165" into CFBundleVersion.
    tag_digits = ENV["APP_VERSION"].to_s.gsub(/\D/, "")
    args << "CURRENT_PROJECT_VERSION=#{tag_digits.to_i}" unless tag_digits.empty?

    sh(*args)

    # An IPA is just a zip holding the .app inside a top-level Payload/ dir.
    app = "#{derived}/Build/Products/Release-iphoneos/App.app"
    UI.user_error!("Expected an app bundle at #{app}, found none.") unless File.directory?(app)

    sh("mkdir", "-p", payload)
    sh("cp", "-R", app, "#{payload}/")
    sh("cd ../build && zip -qry tabulamensa-unsigned.ipa Payload")
    sh("rm", "-rf", payload)

    UI.success("Unsigned IPA: #{File.expand_path(ipa)}")
    UI.important("Push notifications will not work on a build re-signed with a free Apple ID.")
  end

  desc "Build an App Store IPA and upload it to TestFlight"
  lane :beta do
    sync_capacitor

    team_id = apple_team_id
    api_key = app_store_connect_key

    version_number = get_version_number(
      xcodeproj: "ios/App/App.xcodeproj",
      target: "App",
      configuration: "Release"
    )
    local_build_number = get_build_number(
      xcodeproj: "ios/App/App.xcodeproj"
    ).to_i
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      version: version_number,
      initial_build_number: 0
    ).to_s
    # TestFlight may already hold an integer release build ("108") or a local
    # tuple build ("108.2"); split it into major/minor for comparison.
    latest_major = latest_build.split(".")[0].to_i
    latest_minor = latest_build.split(".")[1].to_i

    release_tag = ENV["APP_VERSION"].to_s.strip
    tag_digits = release_tag.gsub(/\D/, "")

    if tag_digits.empty?
      # Local / manual build: append a minor component (108 -> 108.1, 108.1 ->
      # 108.2). The tuple sorts above the current build but stays below the next
      # integer, so ad-hoc builds never claim the number a tagged release will use.
      major = [latest_major, local_build_number].max
      next_build_number = "#{major}.#{latest_minor + 1}"
    else
      # Tagged release build (from CI): the integer digits of the tag become the
      # build number (alpha-0108 -> 108). Guard against going backwards relative
      # to anything already on TestFlight or in the project.
      release_number = tag_digits.to_i
      release_number = latest_major + 1 if release_number <= latest_major
      release_number = local_build_number if local_build_number > release_number
      next_build_number = release_number.to_s
      if release_number != tag_digits.to_i
        UI.important("Tag build number #{tag_digits.to_i} is not ahead of existing builds; using #{next_build_number} instead.")
      end
    end

    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    if ENV["CI"].to_s.casecmp("true").zero?
      # On CI there is no signed-in Xcode account, so automatic signing can't
      # talk to the developer portal. Download an App Store profile with the API
      # key and switch the project to manual signing against the distribution
      # certificate that was imported into the temporary keychain.
      #
      # The app ships two signed bundles — the App and the NotificationService
      # extension — so each needs its own App ID + App Store profile.
      ext_identifier = "#{app_identifier}.NotificationService"

      # The extension's App ID may not exist on the portal yet (it's a newer
      # target). produce can't authenticate with an App Store Connect API key
      # (it wants a legacy Apple ID username), so register the bundle ID straight
      # through the ConnectAPI — the same interface sigh uses with this key.
      require "spaceship"
      require "base64"
      # app_store_connect_key already set Spaceship::ConnectAPI.token (decoding the
      # base64 .p8 for us). Reuse it; only rebuild if it isn't set, decoding the
      # key content ourselves — Token.create wants raw PEM, not base64.
      if Spaceship::ConnectAPI.token.nil?
        key_content = api_key[:is_key_content_base64] ? Base64.decode64(api_key[:key]) : api_key[:key]
        Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
          key_id: api_key[:key_id],
          issuer_id: api_key[:issuer_id],
          key: key_content
        )
      end
      already = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: ext_identifier }).any? do |b|
        b.identifier == ext_identifier
      end
      if already
        UI.message("App ID #{ext_identifier} already registered")
      else
        UI.message("Registering App ID #{ext_identifier}")
        Spaceship::ConnectAPI::BundleId.create(
          name: "Tabula Mensa Notification Service",
          identifier: ext_identifier,
          platform: "IOS"
        )
      end

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: app_identifier,
        readonly: false
      )
      profile_name = lane_context[SharedValues::SIGH_NAME]

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: ext_identifier,
        readonly: false
      )
      ext_profile_name = lane_context[SharedValues::SIGH_NAME]

      update_code_signing_settings(
        path: "ios/App/App.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_name,
        targets: ["App"]
      )
      update_code_signing_settings(
        path: "ios/App/App.xcodeproj",
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: ext_profile_name,
        targets: ["NotificationService"]
      )

      ipa_path = build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        export_team_id: team_id,
        output_directory: "build",
        xcargs: "CURRENT_PROJECT_VERSION=#{next_build_number}",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: {
            app_identifier => profile_name,
            ext_identifier => ext_profile_name
          }
        }
      )
    else
      # Local developer machine: rely on the automatic signing already
      # configured in Xcode, letting it manage the provisioning profile.
      ipa_path = build_app(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        clean: true,
        export_team_id: team_id,
        output_directory: "build",
        xcargs: "DEVELOPMENT_TEAM=#{team_id} CURRENT_PROJECT_VERSION=#{next_build_number} -allowProvisioningUpdates"
      )
    end
    ipa_build_number = get_ipa_info_plist_value(
      ipa: ipa_path,
      key: "CFBundleVersion"
    )
    UI.user_error!("Expected IPA build #{next_build_number}, got #{ipa_build_number}") unless ipa_build_number.to_s == next_build_number.to_s

    # Distribute to the external "Beta Group" as well as the internal testers.
    # External distribution submits the build to Beta App Review, which can't
    # start until processing finishes — so we can't skip the processing wait
    # here the way an internal-only upload could. Internal testers ("Team
    # Rocket") still receive every build automatically regardless of `groups`.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      changelog: release_tag.empty? ? "TableMate build #{next_build_number}" : "TableMate #{release_tag} (build #{next_build_number})",
      distribute_external: true,
      groups: ["Beta Group"],
      notify_external_testers: true,
      skip_waiting_for_build_processing: false
    )
  end
end

platform :android do
  desc "Create a self-signed upload keystore and print the GitHub secrets to add."
  desc "Android sideload signing needs no Apple-style portal round-trip: this just"
  desc "wraps keytool. Run once, e.g.:"
  desc "  bundle exec fastlane android keystore key_password:hunter2"
  lane :keystore do |options|
    # The keystore is a long-lived, irreplaceable credential (losing it breaks
    # sideloaded upgrades), so — like the App Store Connect .p8 — it lives outside
    # the repo, not in the transient fastlane/certs scratch dir.
    output_path = File.expand_path(options[:output_path] || "~/.config/tablemate-android")
    password = options[:key_password]
    alias_name = options[:key_alias] || "tablemate"
    UI.user_error!("Pass key_password:<password> to protect the keystore.") if password.to_s.empty?

    FileUtils.mkdir_p(output_path)
    keystore = File.join(output_path, "tablemate-release.jks")
    UI.user_error!("#{keystore} already exists; delete it first if you mean to regenerate.") if File.exist?(keystore)

    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:package_name)

    sh(
      "keytool", "-genkeypair", "-v",
      "-keystore", keystore,
      "-alias", alias_name,
      "-keyalg", "RSA", "-keysize", "2048",
      "-validity", "10000",
      "-storepass", password,
      "-keypass", password,
      "-dname", "CN=#{app_identifier}, OU=TableMate, O=TableMate, C=US"
    )

    # Drop a sibling keystore.properties so local `fastlane android build` (and
    # plain ./gradlew assembleRelease) sign without any env prefix; CI ignores
    # this file and uses the ANDROID_* env vars instead.
    props_file = File.join(output_path, "keystore.properties")
    File.write(props_file, <<~PROPS)
      storeFile=#{keystore}
      storePassword=#{password}
      keyAlias=#{alias_name}
      keyPassword=#{password}
    PROPS

    UI.success("Keystore written to #{keystore} (outside the repo, alongside the App Store Connect key).")
    UI.message("Local signing config written to #{props_file}; local release builds now sign automatically.")
    UI.important("Add these GitHub secrets, then back up #{keystore} somewhere safe (losing it means sideloaded users must uninstall before upgrading):")
    UI.message("  ANDROID_KEYSTORE_BASE64    = output of:  base64 -i #{keystore}")
    UI.message("  ANDROID_KEYSTORE_PASSWORD  = #{password}")
    UI.message("  ANDROID_KEY_ALIAS          = #{alias_name}")
    UI.message("  ANDROID_KEY_PASSWORD       = #{password}")
  end

  desc "Build a signed Android release APK from the Capacitor app for sideloading"
  lane :build do
    sync_capacitor

    # Mirror the iOS build-number scheme: the integer digits of the release tag
    # (alpha-0108 -> 108) become the versionCode so sideloaded upgrades install
    # over the previous build. Untagged local builds keep gradle's default of 1.
    tag_digits = ENV["APP_VERSION"].to_s.gsub(/\D/, "")
    ENV["ANDROID_VERSION_CODE"] = tag_digits unless tag_digits.empty?

    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release"
    )

    UI.success("APK: #{lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]}")
  end

  desc "Build an Android release AAB for signing and Play Console upload"
  lane :bundle do
    sync_capacitor

    # Same tag-derived versionCode as the APK lane. Without this the AAB falls
    # back to gradle's default of 1, which Play would accept but no existing
    # sideloader could ever install over — an install only moves upward, and
    # released APKs are already numbered in the hundreds.
    tag_digits = ENV["APP_VERSION"].to_s.gsub(/\D/, "")
    ENV["ANDROID_VERSION_CODE"] = tag_digits unless tag_digits.empty?

    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )
  end

  # Resolve the Play Developer API service-account key from, in order: the inline
  # JSON secret (CI), then a file kept outside the repo (developer machines) —
  # the same precedence the keystore above and the App Store Connect key on iOS
  # already use. Returns the argument pair supply wants so callers don't care
  # which one was found.
  private_lane :play_credentials do
    inline = ENV["PLAY_SERVICE_ACCOUNT_JSON"].to_s
    path = ENV["PLAY_SERVICE_ACCOUNT_FILE"] ||
           File.join(Dir.home, ".config/tablemate-android/play-service-account.json")

    if !inline.strip.empty?
      { json_key_data: inline }
    elsif File.exist?(path)
      { json_key: path }
    else
      UI.user_error!(
        "No Play credentials found. Set PLAY_SERVICE_ACCOUNT_JSON (the service " \
        "account's JSON key, used on CI) or save it to #{path}."
      )
    end
  end

  desc "Build the release AAB and upload it to a Play track."
  desc "Track names predate the Console's labels: internal, alpha (= closed"
  desc "testing), beta (= open testing), production. Defaults to internal."
  desc "  bundle exec fastlane android play track:alpha"
  lane :play do |options|
    track = options[:track] || ENV["PLAY_TRACK"] || "internal"
    known = %w[internal alpha beta production]
    unless known.include?(track)
      UI.important("'#{track}' is not one of #{known.join(', ')} — treating it as a custom closed track.")
    end

    # Resolved before building: a missing key should fail in seconds rather than
    # after several minutes of gradle work that gets thrown away.
    creds = play_credentials

    bundle

    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.user_error!("The bundle lane produced no AAB.") if aab.to_s.empty?

    # fastlane runs from fastlane/, so supply's metadata tree is a sibling here.
    metadata_path = File.expand_path("metadata/android")

    # Release notes live at metadata/android/<locale>/changelogs/<versionCode>.txt.
    # Asking supply to upload one that doesn't exist fails the release, so only
    # enable changelogs when the file for this build is actually present.
    version_code = ENV["ANDROID_VERSION_CODE"].to_s.gsub(/\D/, "")
    changelog = File.join(metadata_path, "en-US/changelogs/#{version_code.to_i}.txt")
    has_changelog = !version_code.empty? && File.exist?(changelog)
    UI.message(has_changelog ? "Using release notes from #{changelog}" : "No release notes for this build; skipping changelogs.")

    upload_to_play_store(**creds.merge(
      track: track,
      aab: aab,
      metadata_path: metadata_path,
      release_status: options[:release_status] || "completed",
      skip_upload_apk: true,
      skip_upload_changelogs: !has_changelog,
      # The store listing is edited in the Console and pushed deliberately by the
      # play_metadata lane. Shipping a binary must never quietly rewrite it.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    ))

    UI.success("Uploaded #{File.basename(aab)} to the '#{track}' track.")
  end

  desc "Push the store listing images (icon, feature graphic, screenshots) from"
  desc "fastlane/metadata to Play. Separate from the play lane on purpose: this"
  desc "overwrites what's in the Console, so it should be a deliberate act."
  lane :play_metadata do
    upload_to_play_store(**play_credentials.merge(
      metadata_path: File.expand_path("metadata/android"),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      # No text files in the tree — the listing copy is maintained in the
      # Console — so only the images are ours to push.
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    ))

    UI.success("Store listing images uploaded.")
  end
end
